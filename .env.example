# Copy to .env and adjust. .env is git-ignored and must never be committed.

# Port the Express API + production site listens on.
PORT=3001

# Where the SQLite database and the one-time setup token live.
# This directory is private: never expose it through a static host.
DATA_DIR=.data

# Number of proxy hops in front of the app (nginx/Caddy/Cloudflare = 1).
# IMPORTANT: this defaults to 0, which means X-Forwarded-For is ignored and the
# socket address is used. On a directly-exposed server that is the safe choice:
# otherwise a client could spoof the header and dodge the rate limits.
# Set it to the real number of trusted proxies (usually 1) in production.
TRUST_PROXY_HOPS=0

# Optional comma-separated allow-list for images saved from the dashboard.
# Leave unset to accept any https image host (CSP img-src: https:).
# Example: ALLOWED_IMAGE_HOSTS=files.catbox.moe,cdn.elpaze.online
ALLOWED_IMAGE_HOSTS=

# The API is same-origin only: it never answers with CORS headers, and mutating
# requests whose Origin host differs from the request host are rejected.

# Set by the platform when running `npm start` in production; leave unset locally.
# NODE_ENV=production
