# Copy to .env and adjust. .env is git-ignored and must never be committed.

# Port the Express API + production site listens on.
PORT=3001

# Where the SQLite database and the one-time setup token live.
# This directory is private: never expose it through a static host.
DATA_DIR=.data

# Number of proxy hops in front of the app (nginx/Caddy/Cloudflare = 1).
# Set to 0 when the app is reachable directly, otherwise rate limiting can be spoofed.
TRUST_PROXY_HOPS=1

# Comma-separated list of extra origins allowed to send mutating requests.
# Same-origin requests are always allowed, so leave this empty for a single-domain deploy.
# Example: ALLOWED_ORIGINS=https://elpaze.online,https://www.elpaze.online
ALLOWED_ORIGINS=

# Set by the platform when running `npm start` in production; leave unset locally.
# NODE_ENV=production
